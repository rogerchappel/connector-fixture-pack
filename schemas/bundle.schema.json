{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Connector Fixture Bundle",
  "type": "object",
  "required": [
    "name",
    "version",
    "connectors"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "generatedBy": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
