{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Connector Fixture Request",
  "type": "object",
  "required": [
    "id",
    "connector",
    "operation",
    "method",
    "path",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "connector": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "body": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
